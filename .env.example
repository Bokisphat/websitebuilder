# Fusion CRM — copy to `.env.local` and fill in. Do not commit real keys.
# Server routes send `API-KEY` + `API-URL` (Postman variable `wp_domain` = API-URL header, not a URL query param).

FUSION_HOST_URL=https://fusioncrm.software
FUSION_API_KEY=
# No http/https unless Fusion whitelist shows it (usually: localhost:3000 or your production host).
FUSION_API_URL=localhost:3000

FUSION_SUBSCRIBER=8189
# Raise this so type filters (e.g. Duplex) can see the full feed; cap was causing only the first N rows to be searchable.
FUSION_API_PROPERTIES_LIMIT=100

# Optional: full projects URL (same shape as Postman; subscriber + limit only is typical)
# FUSION_API_PROPERTIES_URL=https://fusioncrm.software/api/fusion/projects?subscriber=8189&limit=100

# NEXT_PUBLIC_SITE_URL=https://example.com

# Cached top-yield strip: POST /api/properties/top-yield/refresh writes data/top-yield-picks.json (commit or deploy that file for instant loads).
# In production, set a secret and send it as header X-Top-Yield-Refresh-Secret or ?secret= on the POST body.
# TOP_YIELD_REFRESH_SECRET=
# Optional pick count when not specified in POST JSON (default 6).
# TOP_YIELD_PICKS_COUNT=6

# Pexels stock images (optional) — https://www.pexels.com/api/ — set in `.env.local`; never commit real keys.
PEXELS_API_KEY=

# Unsplash (optional) — https://unsplash.com/oauth/applications
# Required for image search: Access Key. Optional: Application ID, Secret (OAuth only; not used by /api/unsplash/search).
UNSPLASH_APPLICATION_ID=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# OpenAI — optional, for "Create with AI" in the image library (DALL·E 3). Billing applies.
OPENAI_API_KEY=

# Vercel Postgres / Neon — auto-set when you connect Storage; app accepts POSTGRES_URL, DATABASE_URL, STORAGE_POSTGRES_URL, or STORAGE_URL.
# POSTGRES_URL=
# DATABASE_URL=

# Member saved sites (Fusion subscriber id from /users/subscriber/show/{id})
# Default max sites per subscriber when no row in table member_site_quotas (1–500).
# MEMBER_SITES_MAX=6

# Local API dev only: if X-Fusion-Subscriber-Id header is missing, use this subscriber id (never in production).
# MEMBER_SITES_DEV_SUBSCRIBER=8189

# Demo only: browser sends X-Fusion-Subscriber-Id from this value. Replace with Laravel session / BFF in production.
# NEXT_PUBLIC_DEV_FUSION_SUBSCRIBER_ID=8189
